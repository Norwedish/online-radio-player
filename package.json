{
  "name": "online-radio-player",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted online radio station with a custom interactive playout engine, Thimeo Stereo Tool and Icecast.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @radio/api --filter @radio/playout --filter @radio/web dev",
    "build": "tsc -b && pnpm --filter @radio/web build",
    "build:packages": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false && pnpm --filter @radio/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "config:validate": "tsx scripts/validate-config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "spike:chain": "node scripts/spike-ffmpeg-chain.mjs",
    "spike:fixtures": "node scripts/make-fixtures.mjs",
    "spike:sqlite": "node scripts/spike-sqlite-wal.mjs",
    "spike:hls": "node scripts/spike-hls.mjs",
    "spike:live-ws": "node scripts/spike-live-ws.mjs",
    "spike:live-icecast": "node scripts/spike-live-icecast.mjs",
    "clean": "tsc -b --clean",
    "db:seed": "tsx scripts/cli.ts db:seed",
    "db:backup": "tsx scripts/cli.ts db:backup",
    "db:restore": "tsx scripts/cli.ts db:restore",
    "user:create": "tsx scripts/cli.ts user:create",
    "user:password": "tsx scripts/cli.ts user:password",
    "media:scan": "tsx scripts/cli.ts media:scan",
    "generate": "tsx scripts/cli.ts generate",
    "preview": "tsx scripts/cli.ts preview",
    "retention": "tsx scripts/cli.ts retention",
    "bench:media": "tsx scripts/bench-media.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bench:chain": "tsx scripts/bench-chain.ts",
    "demo": "tsx scripts/demo-stack.ts",
    "test:e2e": "playwright test",
    "icecast:config": "tsx scripts/icecast-config.ts",
    "start:api": "node apps/api/dist/index.js",
    "start:playout": "node apps/playout/dist/index.js",
    "load:test": "tsx scripts/load-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": ">=22",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
