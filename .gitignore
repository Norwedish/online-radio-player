# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
*.local
config/station.json
config/secrets.env

# Runtime data (anchored to the repo root: unanchored `media/` once hid
# apps/api/src/services/media/ from git)
/data/
/logs/
/media/
/recordings/
/backups/
/hls/
/artwork/

# Thimeo Stereo Tool is commercial; never commit binaries, presets or licenses
# (match binaries/archives only: an unanchored `stereotool*` once hid
# apps/playout/src/stereotool/ from git)
*.lic
*.sds
!config/stereotool.example.sds
/stereotool_cmd*
/stereotool_*.zip
/stereotool_*.tar.gz
/vendor/stereotool/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test artifacts
playwright-report/
test-results/
