# Icecast with the generated /etc/radio/icecast.xml (the distro icecast2.service is disabled).
[Unit]
Description=Radio Icecast server
After=network-online.target

[Service]
Type=simple
User=icecast2
Group=icecast
ExecStart=/usr/bin/icecast2 -c /etc/radio/icecast.xml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
LimitNOFILE=65535
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
