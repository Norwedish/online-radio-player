# radio-playout: audio clock, decks, mixer, scheduler, Stereo Tool (child process,
# stdio PCM — ADR 0002), encoder hub. Survives API restarts (PLAN §4.3).
[Unit]
Description=Radio playout engine
After=network-online.target radio-icecast.service
Wants=radio-icecast.service

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/srv/radio/app
EnvironmentFile=/etc/radio/secrets.env
Environment=NODE_ENV=production
Environment=RADIO_CONFIG=/etc/radio/station.json
Environment=PLAYOUT_SOCKET=/run/radio/playout.sock
RuntimeDirectory=radio
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/node apps/playout/dist/index.js
Restart=always
RestartSec=3
LimitNOFILE=65535
CPUQuota=150%
Nice=-5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/radio /run/radio

[Install]
WantedBy=multi-user.target
