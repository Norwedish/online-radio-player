# Generated by scripts/install.sh — edit the template in deploy/nginx, not this file.
# Certbot (--nginx) adds the 443 server block and the HTTP→HTTPS redirect.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /srv/radio/app/apps/web/dist;
    client_max_body_size 500m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "microphone=(self), camera=()" always;
    # hls.js runs its transmuxer in a blob: worker; React sets inline style attributes (meters).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;
    # Certbot enables HSTS together with TLS: add_header Strict-Transport-Security "max-age=31536000" always;

    # Built single-page app (/listen, /admin, /login …)
    location / {
        try_files $uri /index.html;
    }
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
    }

    # Browser studio uplink → playout worker (ADR 0004)
    location /ws/live {
        proxy_pass http://127.0.0.1:__LIVE_PORT__/live;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location /ws {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Icecast's web admin stays on loopback (ssh -L 8000:127.0.0.1:8000 to reach it);
    # never proxy it to the internet (M15.1 security review).
    location ^~ /stream/admin {
        return 404;
    }

    # Icecast mounts (listeners never talk to Icecast directly)
    location /stream/ {
        proxy_pass http://127.0.0.1:__ICECAST_PORT__/;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 24h;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-cache, no-store" always;
    }

    # HLS (ADR 0003): FFmpeg writes the segments, nginx serves them
    location /hls/ {
        alias /srv/radio/hls/;
        types { application/vnd.apple.mpegurl m3u8; video/mp2t ts; }
        add_header Access-Control-Allow-Origin "*" always;
        location ~ \.m3u8$ { add_header Cache-Control "no-store" always; add_header Access-Control-Allow-Origin "*" always; }
        location ~ \.ts$ { add_header Cache-Control "public, max-age=60" always; add_header Access-Control-Allow-Origin "*" always; }
    }

    # Prometheus: scrape from the host only
    location = /metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:__API_PORT__/metrics;
    }
}
