{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "paths": {
      "@radio/shared": ["./packages/shared/src/index.ts"],
      "@radio/core": ["./packages/core/src/index.ts"],
      "@radio/db": ["./packages/db/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/playout/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ]
}
