# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database (SQLite, WAL)
DATABASE_URL=file:./data/radio.db

# Icecast
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change-me-admin

# Session / auth
SESSION_SECRET=change-me-session-secret

# Bootstrap admin (used only by `pnpm db:seed`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Stereo Tool (paths are configurable; do not commit binaries/presets)
STEREOTOOL_BINARY=/opt/stereotool/stereotool_cmd
STEREOTOOL_PRESET=/etc/radio/stereotool.sds
STEREOTOOL_LICENSE=/opt/stereotool/stereotool.lic

# Email alerts / password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=radio@example.com

# Public station URL (used in emails and API docs)
PUBLIC_BASE_URL=https://radio.example.com

# Optional: protect /api/metrics with a Bearer token
METRICS_TOKEN=
