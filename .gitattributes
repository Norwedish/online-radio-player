# Normalize line endings for a Linux-targeted repo.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.flac binary
*.ogg binary
*.opus binary
*.wav binary
*.m4a binary
*.aac binary
